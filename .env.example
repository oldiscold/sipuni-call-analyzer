# Groq API для транскрибации (Whisper) и анализа (Llama 3.3 70B)
# Получить БЕСПЛАТНО: https://console.groq.com
GROQ_API_KEY=gsk_...

# Telegram Bot для отправки фидбека
# Создать бота: @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...

# ID чата для отправки уведомлений
# Узнать: @userinfobot или @getmyid_bot
TELEGRAM_CHAT_ID=123456789

# API-ключ Сипуни для авторизации вебхуков
# Получить в личном кабинете Сипуни
SIPUNI_API_KEY=your_sipuni_api_key

# AmoCRM интеграция (опционально)
# Поддомен без .amocrm.ru, например: mycompany
AMO_SUBDOMAIN=mycompany
# Данные приватной интеграции (Настройки → Интеграции → Создать интеграцию)
AMO_CLIENT_ID=your_client_id
AMO_CLIENT_SECRET=your_client_secret
AMO_REDIRECT_URI=https://example.com
# Токены (получить через OAuth2 один раз, потом обновляются автоматически)
AMO_ACCESS_TOKEN=your_access_token
AMO_REFRESH_TOKEN=your_refresh_token
